{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pwsh -NoProfile -File ./tools/gate/Scripts/Invoke-Gate.ps1*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
